# =================================================================
# Nashm RAG API Configuration
# =================================================================

# Server
RAG_HOST=0.0.0.0
RAG_PORT=8000
DEBUG_RAG_API=false

# Security (Must match JWT_SECRET in Nashm Backend)
JWT_SECRET=

# =================================================================
# Vector Database Selection
# =================================================================
# Options: atlas-mongo | pgvector
VECTOR_DB_TYPE=atlas-mongo

# --- Option A: MongoDB Atlas Vector Search ---
ATLAS_MONGO_DB_URI=
COLLECTION_NAME=testcollection
ATLAS_SEARCH_INDEX=vector_index

# --- Option B: PostgreSQL with pgvector ---
# DB_HOST=db
# DB_PORT=5432
# POSTGRES_DB=mydatabase
# POSTGRES_USER=myuser
# POSTGRES_PASSWORD=mypassword

# =================================================================
# Embeddings Provider Selection
# =================================================================
# Options: google_genai | openai | azure | huggingface | ollama | bedrock

# --- Option A: Google Generative AI (Gemini) ---
EMBEDDINGS_PROVIDER=google_genai
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIMENSIONS=768
RAG_GOOGLE_API_KEY=
# GOOGLE_KEY=

# --- Option B: OpenAI ---
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIMENSIONS=1536
# RAG_OPENAI_API_KEY=
